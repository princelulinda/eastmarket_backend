DB_NAME=

# MBIYOPAY (mobile money payin/payout) — get keys from dashboard.mbiyo.africa > Settings > API & Webhook
MBIYOPAY_API_URL=https://dashboard.mbiyo.africa/api/v1/merchant
MBIYOPAY_API_KEY=
MBIYOPAY_WEBHOOK_SECRET=
# Public URL of this backend — used to build the callback_url sent to MBIYOPAY
# (must be reachable from the internet; use a tunnel like ngrok for local dev).
# Webhook endpoint is Medusa's own generic route: {MEDUSA_BACKEND_URL}/hooks/payment/mbiyopay_mbiyopay
# (segment must match the full provider key pp_mbiyopay_mbiyopay, same pattern as Stripe's pp_stripe_stripe)
# — also set this exact URL + MBIYOPAY_WEBHOOK_SECRET in the MBIYOPAY dashboard
# under Settings > Webhooks.
MEDUSA_BACKEND_URL=
# URL que l'admin appelle. Sans elle, l'admin utilise MEDUSA_BACKEND_URL : en developpement
# l'admin servi sur localhost:9000 tape alors sur l'API publique. Mettre http://localhost:9000
# en local, laisser vide en deploiement.
MEDUSA_ADMIN_BACKEND_URL=

# TRUSTSEND (mobile money) — cle API generee depuis l'Espace client TrustSend.
# Sandbox : https://sandbox-api.trustsend.africa/api/v1 avec une cle ts_sandbox_...
# Production : https://api.trustsend.africa/api/v1 avec une cle ts_live_...
# Une cle envoyee au mauvais environnement est refusee avec un message qui l'indique.
TRUSTSEND_API_URL=https://sandbox-api.trustsend.africa/api/v1
TRUSTSEND_API_KEY=
# Secret renvoye a la creation de l'abonnement webhook (POST /api/v1/business/webhooks,
# url = {MEDUSA_BACKEND_URL}/hooks/trustsend, events mobile_money_deposit.completed et .failed).
# Il n'est affiche qu'une seule fois.
TRUSTSEND_WEBHOOK_SECRET=

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# MinIO / S3 Configuration
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=us-east-1
MINIO_FILE_URL=

# SMTP Email Configuration (Spacemail: mail.spacemail.com, port 465 = SSL implicite -> SMTP_SECURE=true)
# no-reply@eastmarket.africa existe mais l'accès SMTP n'y est pas activé côté
# Spacemail : utiliser notice@eastmarket.africa (confirmé fonctionnel).
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_USER=notice@eastmarket.africa
SMTP_PASS=
SMTP_SECURE=true
SMTP_FROM="East Market <notice@eastmarket.africa>"
# ── CORS ──────────────────────────────────────────────────────────────────
# Medusa applique le CORS par espace de noms. Les routes /vendors/* étant
# personnalisées, elles ont besoin de leur propre liste : sans elle, tout
# client navigateur (le tableau de bord vendeur web) est bloqué au préflight.
# À défaut, on retombe sur STORE_CORS.
VENDOR_CORS=http://localhost:3000

# ── Séquestre marketplace : quand l'argent part chez le vendeur ──────────────
# Le vendeur marque le colis livré, le client a ce délai pour confirmer lui-même.
# Passé ce délai, une relance part ; PAYOUT_GRACE_HOURS après elle, l'argent est
# versé même sans confirmation. Voir src/jobs/release-vendor-payouts.ts.
PAYOUT_CONFIRMATION_DAYS=4
PAYOUT_GRACE_HOURS=24
